# Copy this file to .env.local for local development.
# docker/docker-compose.yml reads .env.local too (via env_file), overriding
# DATABASE_URL/AUTH_URL for the containerized app since it reaches Postgres
# at the `db` service name instead of localhost — see that file's comments.

NODE_ENV=development

# Postgres connection string (port 5433 — kept separate from the
# dashboard-basecode template's 5432 so both can run at once locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/siber

# Auth.js — generate with: openssl rand -base64 33
AUTH_SECRET=

# Only needed in production behind a proxy / non-default port
# AUTH_URL=https://siber.domainnya.my.id

NEXT_PUBLIC_APP_URL=http://localhost:3001

# File uploads (see src/features/files/). Local dev writes here; in Docker
# this is overridden to /app/uploads, a mounted volume (docker-compose.yml).
UPLOAD_DIR=./uploads
# Max size per uploaded file, in megabytes.
MAX_UPLOAD_MB=50

# Used only by `pnpm db:seed` to create the initial admin user
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
